{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biopelayo.github.io/radar-fondos-asturias/schemas/v2/opportunity.schema.json",
  "title": "Radar Fondos Asturias V2 Opportunity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "canonicalReference", "family", "titles", "authority", "geography", "lifecycleStatus", "applicationWindows", "finance", "beneficiaryClasses", "eligibleActivities", "excludedActivities", "incompatibilities", "submission", "sourceRecordIds", "documentRevisionIds", "relatedOpportunityIds", "currentVersionId", "quality", "provenance"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/opportunityId" },
    "canonicalReference": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "family": { "enum": ["grant", "self_employment", "procurement", "loan", "guarantee", "prize", "accelerator"] },
    "titles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "value"],
        "properties": {
          "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
          "value": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "level"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "level": { "enum": ["local", "regional", "national", "eu", "international"] },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "countryCodes", "regionCodes", "executionPlaces"],
      "properties": {
        "scope": { "enum": ["local", "regional", "national", "eu", "international"] },
        "countryCodes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" }, "uniqueItems": true },
        "regionCodes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "executionPlaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "lifecycleStatus": { "enum": ["upcoming", "open", "suspended", "extended", "closed", "cancelled", "awarded"] },
    "applicationWindows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "timeZone", "mode", "verified"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "opensAt": { "$ref": "common.schema.json#/$defs/dateTime" },
          "closesAt": { "$ref": "common.schema.json#/$defs/dateTime" },
          "timeZone": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "mode": { "enum": ["absolute", "relative", "unknown"] },
          "verified": { "type": "boolean" },
          "relativeRule": { "type": "string", "minLength": 1 }
        }
      }
    },
    "finance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "eligibleCostNotes"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "programmeBudget": { "type": "number", "minimum": 0 },
        "applicantMinimum": { "type": "number", "minimum": 0 },
        "applicantMaximum": { "type": "number", "minimum": 0 },
        "aidIntensityPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "eligibleCostNotes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "repayableAmount": { "type": "number", "minimum": 0 },
        "nonRepayableAmount": { "type": "number", "minimum": 0 }
      }
    },
    "beneficiaryClasses": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "eligibleActivities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "excludedActivities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "incompatibilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "aidRegime": { "type": "string", "minLength": 1 },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["officialUrl", "channel"],
      "properties": {
        "officialUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "channel": { "enum": ["electronic", "in_person", "mixed", "unknown"] },
        "registry": { "type": "string", "minLength": 1 },
        "electronicSignatureRequired": { "type": "boolean" }
      }
    },
    "sourceRecordIds": { "$ref": "common.schema.json#/$defs/sourceRecordIds", "minItems": 1 },
    "documentRevisionIds": { "$ref": "common.schema.json#/$defs/documentRevisionIds" },
    "relatedOpportunityIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/opportunityId" }, "uniqueItems": true },
    "currentVersionId": { "$ref": "common.schema.json#/$defs/opportunityVersionId" },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeness", "evidenceCoverage", "conflictCount", "reviewStatus"],
      "properties": {
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "conflictCount": { "type": "integer", "minimum": 0 },
        "reviewStatus": { "enum": ["unreviewed", "needs_review", "reviewed"] }
      }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  }
}
