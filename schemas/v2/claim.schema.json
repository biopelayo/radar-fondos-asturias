{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biopelayo.github.io/radar-fondos-asturias/schemas/v2/claim.schema.json",
  "title": "Radar Fondos Asturias V2 Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "opportunityId", "path", "valueType", "value", "extraction", "confidence", "evidence", "reviewStatus", "alternatives", "conflict"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/claimId" },
    "opportunityId": { "$ref": "common.schema.json#/$defs/opportunityId" },
    "opportunityVersionId": { "$ref": "common.schema.json#/$defs/opportunityVersionId" },
    "path": { "type": "string", "pattern": "^/" },
    "valueType": { "enum": ["string", "number", "boolean", "date", "datetime", "money", "list", "object", "null"] },
    "value": {},
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version"],
      "properties": {
        "method": { "enum": ["api", "rule", "native_text", "ocr", "manual", "inference"] },
        "version": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidencePointer" } },
    "reviewStatus": { "enum": ["unreviewed", "confirmed", "rejected", "conflict", "needs_review"] },
    "alternatives": { "type": "array" },
    "conflict": { "type": "boolean" },
    "effectiveAt": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
